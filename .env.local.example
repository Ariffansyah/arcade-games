# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key in here.
#
# Everything Postgres-side lives in supabase/schema.sql — run that in the
# Supabase SQL editor before the first deploy, and again after changing it.

# ── Every room ───────────────────────────────────────────────────────────────
# Project URL and anon key, from Supabase → Project Settings → API.
# NEXT_PUBLIC_* values are inlined when the bundle is built, so setting them on
# an already-running deployment does nothing until you rebuild.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Rate limits ──────────────────────────────────────────────────────────────
# Service-role key, same page. Server-side only — it bypasses row-level
# security, so it must never be renamed to NEXT_PUBLIC_ anything.
#
# Without it the request caps fall back to per-process memory, which on Vercel
# means a fresh counter for every lambda and effectively no cap at all. Set it
# in the Vercel project as well as here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Drawings the whole app may buy per day, across every player. This is the
# number that bounds the Groq bill — per-caller limits do not, because addresses
# are cheap. Optional; defaults to 400.
DOODLE_DAILY_CAP=400

# ── Machine Doodle ───────────────────────────────────────────────────────────
# Groq key, server-side only. Leave it out and that one cabinet reports itself
# off duty; every other game still works.
GROQ_API_KEY=your-groq-key

# Pin a model id instead of picking the best one on the account. Optional.
# GROQ_MODEL=

# ── Imposter ─────────────────────────────────────────────────────────────────
# Any long random string — `openssl rand -hex 32` will do. Roles are derived
# from it server-side, so a value anybody can read is the same as no secret.
# There is no shipped default: in production the route refuses to deal roles
# until this is set.
IMPOSTER_SECRET=generate-your-own
